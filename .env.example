# SWE-Together — environment template.
# Copy to .env at the repo root, then fill in what you need. `.env` is gitignored:
# keep API keys AND site-specific cluster settings here, never in tracked files.

# ── Sandbox: where trials and the judge run ──────────────────────────────
# e2b     cloud microVMs, needs E2B_API_KEY (Pro tier for the 90-min trial budget)
# docker  local Docker for trials; the judge still runs on E2B
# enroot  enroot containers on Slurm compute nodes, no sandbox account needed
#         (see docs/sandboxes.md and scripts/slurm/launch.py)
SWT_SANDBOX=e2b
# Judge-only override (e2b | enroot). Normally leave unset.
# JUDGE_SANDBOX=

# ── Model access ─────────────────────────────────────────────────────────
# Minimal setup: ONE OpenRouter key serves the agent, the user simulator, the
# message tagger and the judge (JUDGE_VIA_OR=1). Pass the OpenRouter slugs:
#   --user-model openrouter/google/gemini-3.1-pro-preview      (run stage)
#   --tag-model  openrouter/google/gemini-3.1-pro-preview      (judge stage)
OPENROUTER_API_KEY=
JUDGE_VIA_OR=1
# run_batch.py only checks that this is non-empty when JUDGE_VIA_OR=1.
ANTHROPIC_API_KEY=unused-placeholder-judge-routes-via-openrouter

# Native keys — set these instead if you prefer direct provider access.
# GEMINI_API_KEY=            user simulator + tagging (default models are gemini/…)
# ANTHROPIC_API_KEY=         judge via api.anthropic.com (and unset JUDGE_VIA_OR)
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=            ChatGPT codex OAuth: log in via `codex` CLI; can be a placeholder
# GOOGLE_API_KEY=
# GLM_API_KEY=
# MINIMAX_API_KEY=
# ARK_API_KEY=
# CHUTES_API_KEY=
# FIREWORKS_API_KEY=
# ZAI_API_KEY=

# ── LLM backends per seat (docs/llm_backends.md) ─────────────────────────
# Four seats: agent (the model under test), user_sim, judge, tagger. Each can be
# served by `bedrock`, `openrouter`, or `native` (the vendor's own API). A model
# named by its registry name (gpt-5.6-sol, claude-opus-4.6, gemini-3.1-pro) is
# translated to the id the chosen backend expects; a full provider/model string
# (openrouter/meta/muse-spark-1.3, bedrock/global.openai.gpt-5.6-sol) is used
# as-is. Precedence: CLI flag > plan-file `agent_backend` > SWT_<SEAT>_BACKEND >
# SWT_LLM_BACKEND > native. Unset = today's behaviour.
# SWT_LLM_BACKEND=openrouter
# SWT_AGENT_BACKEND=bedrock
# SWT_USER_SIM_BACKEND=openrouter
# SWT_JUDGE_BACKEND=openrouter    # also honours the legacy JUDGE_VIA_OR / JUDGE_VIA_CODEX
# SWT_TAGGER_BACKEND=openrouter
# Optional default model per seat (registry name or provider/model string).
# SWT_JUDGE_MODEL=claude-opus-4.6

# ── AWS Bedrock ──────────────────────────────────────────────────────────
# Bedrock is called with standard AWS credentials (AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN). If your environment has no
# ambient credentials, give a command that prints AWS `credential_process`
# JSON; it is run on demand and re-run before the lease expires (Slurm jobs
# mint their own — the launcher never copies credentials into a job).
# `{lease}` is replaced by SWT_AWS_LEASE.
# SWT_AWS_CREDENTIAL_CMD="<your-sso-tool> aws get-creds <account-id> -r <role> -d {lease} --output cli"
# SWT_AWS_LEASE=4h
# SWT_AWS_REGION=us-west-2
# Alternative: an AWS profile whose config has a credential_process line.
# AWS_PROFILE=bedrock
# Client certificate some credential tools require (exported as THRIFT_TLS_CL_*
# only for that command).
# SWT_UCLOUD_CERT=
# Claude Code's background model when the judge runs on Bedrock.
# SWT_BEDROCK_SMALL_FAST_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0
# Note: Claude Fable 5 / 5.1 on Bedrock additionally require the AWS account's
# data-retention mode to be `provider_data_share` in the calling region.

# ── Sandbox: e2b ─────────────────────────────────────────────────────────
E2B_API_KEY=
# Only for private task images; the published ghcr.io/togetherbench/* images are public.
# GHCR_USER=
# GHCR_TOKEN=

# ── Sandbox: enroot ──────────────────────────────────────────────────────
# .sqsh image store (~130 GB for all 109 tasks). Default: <repo>/enroot_images.
# Layout is <root>/_store + <root>/swe_together symlinks, so an existing store
# with that convention can be shared.
# SWT_IMAGE_STORE=
# tmpfs base for container rootfs (must be tmpfs, e.g. under /dev/shm).
# SWT_ENROOT_BASE=/dev/shm/swt

# Slurm submission settings used by scripts/slurm/launch.py. Site-specific — that
# is why they live here and not in the script.
# SLURM_QOS=
# SLURM_ACCOUNT=
# SLURM_PARTITION=
# SLURM_EXTRA=                 # extra #SBATCH directives, ';'-separated
# SWT_CONDA_ENV=swetogether    # conda env name or absolute prefix on the compute nodes

# ── Optional ─────────────────────────────────────────────────────────────
# GITHUB_TOKEN=
# REBUILD_TOKEN=
# BUCKET_NAME=                 # trace upload (also BUCKET_ENDPOINT/ACCESS_KEY/SECRET_KEY)
